cabal-version:      3.8

name:               turek3

version:            0.1.0.0

license:            BSD-3-Clause

author:             TurekJakub

maintainer:         jakubturek32@gmail.com

category:           Development
build-type:         Simple

library
    exposed-modules:  LogoProtocol

    build-depends:    base

    ghc-options:      -Wall

    hs-source-dirs:   lib/

    default-language: GHC2021

common warnings
    ghc-options: -Wall 

common deps-turek3
    build-depends:  base, network, stm, containers, turek3

executable turek3-logoserver
    import:           warnings, deps-turek3

    main-is:      LogoServer.hs   

    hs-source-dirs:   src/

    default-language: GHC2021


executable turek3-logoclient
    import:           warnings, deps-turek3

    build-depends: optparse-applicative, lens, gloss, mtl

    main-is:      LogoClient.hs   

    hs-source-dirs:   src/

    default-language: GHC2021

